{
  "name": "antikythera-agent",
  "version": "1.8.5",
  "description": "General-purpose agent runtime with multi-agent orchestration, MCP tool integration, and WebAssembly support",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "antikythera_wasm_bindgen_bg.wasm",
    "antikythera_wasm_bindgen.js",
    "antikythera_wasm_bindgen.d.ts",
    "README.md",
    "pkg-nodejs",
    "component",
    "runtime"
  ],
  "exports": {
    ".": { "types": "./index.d.ts", "default": "./index.js" },
    "./runtime": {
      "types": "./runtime/index.d.ts",
      "default": "./runtime/index.js"
    },
    "./component": {
      "types": "./component/antikythera-sdk.d.ts",
      "default": "./component/antikythera-sdk.js"
    },
    "./antikythera_wasm_bindgen": {
      "browser": { "types": "./antikythera_wasm_bindgen.d.ts", "default": "./antikythera_wasm_bindgen.js" },
      "node": { "types": "./pkg-nodejs/antikythera_wasm_bindgen.d.ts", "default": "./pkg-nodejs/antikythera_wasm_bindgen.js" },
      "default": { "types": "./antikythera_wasm_bindgen.d.ts", "default": "./antikythera_wasm_bindgen.js" }
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "agent",
    "runtime",
    "mcp",
    "llm",
    "wasm",
    "multi-agent",
    "orchestration"
  ],
  "author": "tsfarizi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tsfarizi/antikythera-agent-sdk"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
