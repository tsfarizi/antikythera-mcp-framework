package antikythera:agent-sdk@1.0.0;

/// LlmRequest
record llm-request {
  provider: option<string>,
  model: option<string>,
  session-id: option<string>,
  messages-json: string,
  force-json: bool,
  temperature: option<float32>,
  max-tokens: option<u32>,
  schema-name: option<string>,
  metadata-json: option<string>,
}

/// LlmResponse
record llm-response {
  content: string,
  model: option<string>,
  session-id: option<string>,
  message-json: option<string>,
  tokens-used: option<u32>,
  finish-reason: option<string>,
  raw-response-json: option<string>,
}

/// ToolCallEvent
record tool-call-event {
  tool-name: string,
  arguments-json: string,
  session-id: option<string>,
  step-id: u32,
}

/// ToolExecutionResult
record tool-execution-result {
  tool-name: string,
  success: bool,
  output-json: string,
  error-message: option<string>,
  step-id: u32,
}

/// LogEvent
record log-event {
  level: string,
  message: string,
  timestamp: option<string>,
}

/// DelegatingAgent<H: HostImports>
record delegating-agent<-h: -host-imports> {
  host: h,
  session-id: option<string>,
  step-counter: u32,
  max-steps: u32,
}

/// HostImports
interface host-imports {
  call-llm(request: llm-request) -> result<llm-response, string>;
  emit-tool-call(event: tool-call-event) -> result<tool-execution-result, string>;
  log-message(event: log-event);
  save-state(context-id: string, state-json: string) -> result<_, string>;
  load-state(context-id: string) -> result<option<string>, string>;
}

/// PromptManager — host-side prompt storage interface
interface prompt-manager {
  /// Retrieve a prompt template by its identifier.
  get-prompt(prompt-id: string) -> result<option<string>, string>;
  /// List all available prompt identifiers.
  list-prompts() -> result<list<string>, string>;
}

/// McpClient — host-side MCP server proxy interface
interface mcp-client {
  /// List tools exposed by a connected MCP server.
  list-tools(server-id: string) -> result<list<tool-call-event>, string>;
  /// Invoke a tool on an MCP server and return the result.
  invoke-tool(server-id: string, tool-name: string, input-json: string) -> result<tool-execution-result, string>;
}

/// FfiServer — optional REST bridge for non-WASM hosts
interface ffi-server {
  /// Start the HTTP bridge on the given bind address.
  start(bind-address: string) -> result<_, string>;
  /// Gracefully stop the HTTP bridge.
  stop() -> result<_, string>;
}

world antikythera-agent-sdk {
    import host-imports;
    export prompt-manager;
    export mcp-client;
    export ffi-server;
}
